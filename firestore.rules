rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validRequest(d) {
      return d.keys().hasOnly([
          'name', 'phone', 'email', 'service', 'eventDate', 'eventTime',
          'location', 'notes', 'status', 'consent', 'createdAt',
          'agendamento', 'atendimentoConcluido', 'encerradoEm', 'financeiro', 'historico', 'reabertoEm', 'canceladoEm'
        ])
        && d.keys().hasAll([
          'name', 'phone', 'service', 'eventDate',
          'status', 'consent', 'createdAt'
        ])
        && d.name is string
        && d.name.size() >= 2
        && d.name.size() <= 120
        && d.phone is string
        && d.phone.size() >= 8
        && d.phone.size() <= 35
        && d.service in [
          'Casamento',
          'Pré-wedding',
          'Ensaio fotográfico',
          'Fotografia e videografia',
          'Outro evento'
        ]
        && d.eventDate is string
        && d.eventDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('eventTime' in d) || (d.eventTime is string && d.eventTime.size() <= 30))
        && (!('email' in d) || (d.email is string && d.email.size() <= 160))
        && (!('location' in d) || (d.location is string && d.location.size() <= 160))
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 1000))
        && d.status in ['novo', 'nova']
        && d.consent == true
        && d.createdAt == request.time;
    }

    // Administradores: documento criado manualmente no Console Firebase.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Configurações do site: leitura pública, edição pelo administrador
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Álbuns: visitantes leem apenas publicados, administradores leem e editam todos
    match /albums/{albumId} {
      allow read: if resource.data.status == 'published' || isAdmin();

      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.status in ['draft', 'published'];

      allow delete: if isAdmin();

      // Fotografias dentro do álbum: leitura aberta para exibição da galeria
      match /photos/{photoId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Contagem e listagem de fotos no painel administrativo
    match /{path=**}/photos/{photoId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    function validTestimonial(d) {
      return d.keys().hasOnly(['name', 'text', 'rating', 'published', 'featured', 'createdAt'])
        && d.keys().hasAll(['name', 'text', 'rating', 'published', 'createdAt'])
        && d.name is string
        && d.name.size() >= 2
        && d.name.size() <= 80
        && d.text is string
        && d.text.size() >= 10
        && d.text.size() <= 800
        && (d.rating is int || d.rating is number)
        && d.rating >= 1
        && d.rating <= 5
        && d.published == false
        && (!('featured' in d) || d.featured == false)
        && d.createdAt == request.time;
    }

    // Depoimentos: público pode ler os aprovados e enviar novos como pendentes
    match /testimonials/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() || validTestimonial(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Solicitações de orçamento: visitantes criam, administradores leem/gerenciam
    match /requests/{id} {
      allow create: if validRequest(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Transações financeiras: acesso restrito exclusivamente a administradores
    match /financial_transactions/{id} {
      allow read, write: if isAdmin();
    }
  }
}
