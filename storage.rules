rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Leitura pública das fotografias e miniaturas (nomes gerados com UUID aleatório)
    // Permite que visitantes e páginas públicas carreguem as imagens sem falhas de permissão cross-service.
    match /albums/{albumId}/{file} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.size < 35 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null;
    }

    // Demais caminhos do armazenamento
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
